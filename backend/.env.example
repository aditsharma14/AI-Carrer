NODE_ENV=development
PORT=4000
# Seconds the API keeps serving after /ready flips to 503 on shutdown, in ms.
SHUTDOWN_DRAIN_MS=5000

MONGODB_URI=mongodb://localhost:27017/ai-career-coach

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------------------------------------------------------------------------
# AI. Recommended setup: Groq for chat + Hugging Face for embeddings.
#   Groq key:  https://console.groq.com/keys
#   HF token:  https://huggingface.co/settings/tokens
#              (fine-grained, with "Make calls to Inference Providers")
# Use AI_PROVIDER=stub / EMBEDDING_PROVIDER=stub to run with no keys
# (canned answers; match scores are meaningless).
# ---------------------------------------------------------------------------

# Chat: stub | groq | huggingface | ollama
AI_PROVIDER=groq
GROQ_API_KEY=
# Optional model override. Defaults:
#   groq:        llama-3.3-70b-versatile
#   huggingface: openai/gpt-oss-120b:fastest  (suffix :fastest | :cheapest | :<provider>)
#   ollama:      llama3.1                     (local, no key)
AI_MODEL=
# How to request JSON on groq/huggingface: json_schema | json_object | none
# (json_schema only on models that support it, e.g. openai/gpt-oss-120b on Groq)
AI_JSON_MODE=
AI_MAX_TOKENS=4096
AI_TIMEOUT_MS=120000

# Embeddings: stub | huggingface | ollama   (Groq has no embeddings API)
EMBEDDING_PROVIDER=huggingface
HF_TOKEN=
# Optional model override. Defaults:
#   huggingface: BAAI/bge-small-en-v1.5
#   ollama:      nomic-embed-text
EMBEDDING_MODEL=
# Only if HF changes its embeddings route:
HF_EMBEDDING_URL=

# Local alternative (no keys): AI_PROVIDER=ollama, EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

CLIENT_ORIGIN=http://localhost:5173
